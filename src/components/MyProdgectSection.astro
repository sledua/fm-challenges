---
import HeaderSection from "./HeaderSection.astro";
import Section from "./Section.astro";
import { getCollection } from "astro:content";
const projects = await getCollection("project");
const heading = "Мої Проекти";
const cta = { text: 'Переглянути всі', href: '/projects' };

---
<Section dark={true}>
  
  <HeaderSection {heading} {cta} />
  <div class="projects-container">
    {projects.map(project => (
      <div class="card">
        <img src={project.data.image} alt={project.data.title} />
        <h3>
          <a href={project.data.liveSiteURL} target="_blank" rel="noopener noreferrer">
            {project.data.title} </a>
        </h3>
        <p>{project.data.description}</p>
        </div>
    ))}
  </div>
</Section>

<style>

  .projects-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    
    .card {
      overflow: hidden;
      transition: transform 0.3s;
      display: flex;
      flex-direction: column;

        img {
            width: 100%;
            height: auto;
            border-radius: 8px;
            margin-bottom: 16px;
        }
    }

    h3 {
      margin-top: 20px;;
    }
      
      a {
        text-decoration: none;
        color: var(--dark);
        font-weight:  600;
        font-size: 18px;
      }
      
      @media (max-width: 700px) {
        & {
          grid-template-columns: 1fr;
        }
        
      
    }
  }
</style>